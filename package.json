{
  "name": "weaver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "description": "A self-healing web data control plane built on Bright Data Scraper Studio",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "weaver": "tsx apps/cli/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm typecheck && pnpm --filter @weaver/web build",
    "db:push": "pnpm --filter @weaver/db push",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.8",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "3.2.4"
  }
}
