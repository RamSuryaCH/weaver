# Bright Data API key. Get it from https://brightdata.com/cp/setting
# The CLI also accepts `bdata login --api-key <key>`, which writes its own
# credential store. Weaver reads this variable so the same key works in CI,
# where the browser-based `bdata login` flow cannot run.
BRIGHTDATA_API_KEY=

# Where the SQLite database lives. Relative paths resolve from the repo root.
WEAVER_DB_PATH=data/weaver.db

# live    — trigger real collectors against Bright Data (spends credits)
# replay  — read recorded runs from fixtures/, spends nothing.
#           This is the default so a judge can explore without an account.
WEAVER_MODE=replay

# manual  — never heal automatically; report and stop
# gated   — heal, but only approve when the preview passes the contract
# auto    — heal and approve without the contract gate (not recommended)
WEAVER_HEAL_POLICY=gated

# Optional: repository used for escalation issues, in "owner/name" form.
# Requires the `gh` CLI to be authenticated.
WEAVER_ESCALATION_REPO=
